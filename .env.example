# LLM providers
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Provider order: groq (primary) → gemini (fallback) by default
# Change to "gemini" to swap if needed
LLM_PRIMARY_PROVIDER=groq

# Model selection
GEMINI_MODEL=gemini-1.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Local embedding model (no API key required)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Set to "true" in sandboxes without HuggingFace internet access
EMBEDDING_OFFLINE_FALLBACK=false

# LLM retry/backoff (per provider)
LLM_MAX_RETRIES=4
LLM_BASE_DELAY_SECONDS=1.0
LLM_MAX_DELAY_SECONDS=20.0
LLM_CACHE_ENABLED=true
